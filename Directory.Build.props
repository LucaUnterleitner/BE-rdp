<Project>
  <!-- Shared build settings. The product version is set here only; build.ps1 can override it with -p:Version=. -->
  <PropertyGroup>
    <Version Condition="'$(Version)' == ''">0.9.0</Version>
    <Company>BearingPoint</Company>
    <Product>BearingPoint Remote Desktop</Product>
    <Copyright>BearingPoint</Copyright>
    <Authors>BearingPoint</Authors>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <InvariantGlobalization>false</InvariantGlobalization>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <!-- CA1848/CA2254: no Microsoft.Extensions.Logging; CA1031: catch-all is deliberate at integration boundaries;
         CA1303: UI strings are not localized yet; CA2007: no ConfigureAwait in UI code. -->
    <NoWarn>$(NoWarn);CA1848;CA2254;CA1031;CA1303;CA2007;CA1305;CA1307;CA1309;CA1310;CA1311;CA1304;CA1062;CA1716;CA1515;CA1812;CA1859;CA1822;CA1805;CA2000;CA1001;CA1063;CA1816;CA1051;CA1707;CA1002;CA1819;CA1720;CA1024;CA1863;CA1865;CA1866;CA1867;CA1869;CA1854;CA1860;CA1861;CA1508;CA1056;CA1054;CA1055;CA2234;CA1308;CA1806;CA1034;CA5394;CA1032;CA1064;CA2201;CA1725;CA1711;CA1849;CA1847;CA2016;CA1835;CA1826;CA1870</NoWarn>
    <DebugType>portable</DebugType>
  </PropertyGroup>
</Project>
