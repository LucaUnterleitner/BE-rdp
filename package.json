{
  "name": "bearingpoint-remote-desktop",
  "productName": "BearingPoint Remote Desktop",
  "version": "0.3.0",
  "description": "Internal BearingPoint Remote Desktop client (drives the Windows RDP client mstsc.exe)",
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "icons": "node tools/make-icons.js",
    "dist:msi": "electron-builder --win msi --x64",
    "dist:dir": "electron-builder --win dir --x64"
  },
  "author": "BearingPoint",
  "license": "UNLICENSED",
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.2",
    "koffi": "^3.3.2"
  },
  "build": {
    "appId": "com.bearingpoint.remotedesktop",
    "productName": "BearingPoint Remote Desktop",
    "copyright": "BearingPoint",
    "asar": true,
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "!**/*.test.js"
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "loadBrowserProcessSpecificV8Snapshot": false,
      "grantFileProtocolExtraPrivileges": false
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "msi",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "msi": {
      "perMachine": true,
      "oneClick": true,
      "runAfterFinish": false,
      "upgradeCode": "E72E3B1E-1A7C-4395-AE16-2FA44C738168",
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "shortcutName": "BearingPoint Remote Desktop"
    }
  }
}
