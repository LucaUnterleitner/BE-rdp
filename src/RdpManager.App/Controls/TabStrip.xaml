<UserControl x:Class="RdpManager.App.Controls.TabStrip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:RdpManager.App.Controls"
             xmlns:s="clr-namespace:RdpManager.App.Sessions"
             xmlns:vm="clr-namespace:RdpManager.App.ViewModels"
             x:Name="Root">
  <UserControl.Resources>
    <Style x:Key="TabBorder" TargetType="Border">
      <Setter Property="MinWidth" Value="120"/>
      <Setter Property="MaxWidth" Value="220"/>
      <Setter Property="Height" Value="35"/>
      <Setter Property="Margin" Value="0,0,2,0"/>
      <Setter Property="CornerRadius" Value="4,4,0,0"/>
      <Setter Property="BorderThickness" Value="1,1,1,0"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="TextElement.Foreground" Value="{StaticResource Gray700Brush}"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource Gray200Brush}"/></Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="TabMain" TargetType="Button">
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="Transparent" Padding="12,0,8,0"><ContentPresenter VerticalAlignment="Center"/></Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- Active tab: white with a brand-colored top line -->
    <Style x:Key="ActiveTab" TargetType="Border" BasedOn="{StaticResource TabBorder}">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
      <Setter Property="TextElement.Foreground" Value="{StaticResource TextPrimaryBrush}"/>
      <Setter Property="TextElement.FontWeight" Value="SemiBold"/>
    </Style>
  </UserControl.Resources>

  <Border x:Name="Bar" Background="{StaticResource Gray100Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,6,12,0">
    <DockPanel>
      <TextBlock DockPanel.Dock="Right" x:Name="Hint" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" Margin="12,0,0,6" TextWrapping="NoWrap"/>
      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Focusable="False" VerticalAlignment="Bottom">
        <StackPanel Orientation="Horizontal" x:Name="Tabs" KeyboardNavigation.TabNavigation="Once" KeyboardNavigation.DirectionalNavigation="Cycle">
          <!-- Home (main window only) -->
          <Border x:Name="HomeTab" MinWidth="0" Style="{StaticResource TabBorder}">
            <Grid>
              <Rectangle x:Name="HomeLine" Height="2" VerticalAlignment="Top" Fill="{StaticResource PrimaryBrush}" Visibility="Collapsed"/>
              <Button Style="{StaticResource TabMain}" Click="OnHome" AutomationProperties.Name="Home">
                <StackPanel Orientation="Horizontal"><c:Icon Data="{StaticResource Icon.dashboard}" Size="16" Margin="0,0,8,0"/><TextBlock Text="Home" Margin="0,0,4,0"/></StackPanel>
              </Button>
            </Grid>
          </Border>
          <!-- Pages (system details) -->
          <ItemsControl x:Name="PageTabs" Focusable="False">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:PageTab">
                <Border x:Name="B" Style="{StaticResource TabBorder}">
                  <Grid>
                    <Rectangle x:Name="Line" Height="2" VerticalAlignment="Top" Fill="{StaticResource PrimaryBrush}" Visibility="Collapsed"/>
                    <DockPanel>
                      <Button DockPanel.Dock="Right" Style="{StaticResource IconButton.Small}" Width="24" Height="24" Margin="0,0,6,0" ToolTip="Close" AutomationProperties.Name="Close tab"
                              Command="{Binding ClosePageTabCommand, Source={x:Static vm:MainViewModel.Instance}}" CommandParameter="{Binding Id}">
                        <c:Icon Data="{StaticResource Icon.close}" Size="16"/>
                      </Button>
                      <Button Style="{StaticResource TabMain}" Command="{Binding PageTabCommand, Source={x:Static vm:MainViewModel.Instance}}" CommandParameter="{Binding Id}" AutomationProperties.Name="{Binding Title}">
                        <StackPanel Orientation="Horizontal"><c:Icon Data="{StaticResource Icon.info}" Size="16" Margin="0,0,8,0"/><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/></StackPanel>
                      </Button>
                    </DockPanel>
                  </Grid>
                </Border>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter TargetName="B" Property="Style" Value="{StaticResource ActiveTab}"/>
                    <Setter TargetName="Line" Property="Visibility" Value="Visible"/>
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <!-- Sessions -->
          <ItemsControl x:Name="SessionTabs" Focusable="False">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="s:SessionTab">
                <Border x:Name="B" Style="{StaticResource TabBorder}" Tag="{Binding Id}"
                        PreviewMouseLeftButtonDown="OnSessionMouseDown" MouseMove="OnSessionMouseMove" PreviewMouseLeftButtonUp="OnSessionMouseUp" MouseRightButtonUp="OnSessionMenu">
                  <Grid>
                    <Rectangle x:Name="Line" Height="2" VerticalAlignment="Top" Fill="{StaticResource PrimaryBrush}" Visibility="Collapsed"/>
                    <DockPanel>
                      <Button DockPanel.Dock="Right" Style="{StaticResource IconButton.Small}" Width="24" Height="24" Margin="0,0,6,0" ToolTip="Disconnect"
                              AutomationProperties.Name="{Binding Name, StringFormat=Disconnect {0}}" Click="OnSessionClose" Tag="{Binding Id}">
                        <c:Icon Data="{StaticResource Icon.close}" Size="16"/>
                      </Button>
                      <Button Style="{StaticResource TabMain}" Tag="{Binding Id}" Click="OnSessionClick" KeyDown="OnSessionKey" AutomationProperties.Name="{Binding AutomationName}">
                        <StackPanel Orientation="Horizontal">
                          <c:Spinner Width="12" Height="12" Margin="0,0,8,0" Visibility="{Binding IsBusy, Converter={StaticResource Visible}}"/>
                          <Ellipse x:Name="Dot" Width="8" Height="8" Margin="0,0,8,0" Fill="{Binding State, Converter={StaticResource KindBrush}}" Visibility="{Binding IsBusy, Converter={StaticResource Visible}, ConverterParameter=invert}"/>
                          <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                      </Button>
                    </DockPanel>
                  </Grid>
                </Border>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter TargetName="B" Property="Style" Value="{StaticResource ActiveTab}"/>
                    <Setter TargetName="Line" Property="Visibility" Value="Visible"/>
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
    </DockPanel>
  </Border>
</UserControl>
