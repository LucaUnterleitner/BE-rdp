<!-- Templates of the rows that make up the virtualized lists (dashboard, systems, favorites, recent). -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:RdpManager.App.ViewModels"
                    xmlns:c="clr-namespace:RdpManager.App.Controls">

  <!-- Status: icon or dot plus text, never color alone -->
  <DataTemplate x:Key="StatusBadge" DataType="vm:ConnectionItem">
    <StackPanel Orientation="Horizontal" TextElement.Foreground="{Binding StatusKey, Converter={StaticResource KindBrush}}" ToolTip="{Binding StatusTooltip}" ToolTipService.IsEnabled="{Binding StatusTooltip, Converter={StaticResource Visible}}" VerticalAlignment="Center">
      <Ellipse Width="10" Height="10" Margin="0,0,6,0" Fill="{Binding StatusKey, Converter={StaticResource KindBrush}}" Visibility="{Binding StatusDot, Converter={StaticResource Visible}}"/>
      <c:Icon Size="16" Margin="0,0,6,0" Data="{Binding StatusIcon, Converter={StaticResource Icon}}" Visibility="{Binding StatusDot, Converter={StaticResource Visible}, ConverterParameter=invert}"/>
      <TextBlock Text="{Binding StatusLabel}" FontWeight="SemiBold"/>
    </StackPanel>
  </DataTemplate>

  <!-- Favorite star -->
  <Style x:Key="FavButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
    <Setter Property="Command" Value="{Binding FavoriteCommand, Source={x:Static vm:MainViewModel.Instance}}"/>
    <Setter Property="CommandParameter" Value="{Binding}"/>
    <Setter Property="ToolTip" Value="Add to favorites"/>
    <!-- Templates, not element instances: a style setter value is shared by every button that uses the style. -->
    <Setter Property="Content" Value="{Binding}"/>
    <Setter Property="ContentTemplate">
      <Setter.Value><DataTemplate><c:Icon Data="{StaticResource Icon.star}"/></DataTemplate></Setter.Value>
    </Setter>
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsFavorite}" Value="True">
        <Setter Property="ToolTip" Value="Remove from favorites"/>
        <Setter Property="Foreground" Value="{StaticResource Gray900Brush}"/>
        <Setter Property="ContentTemplate">
          <Setter.Value><DataTemplate><c:Icon Data="{StaticResource Icon.star}" Fill="{StaticResource PrimaryBrush}"/></DataTemplate></Setter.Value>
        </Setter>
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="CardBorder" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Padding" Value="20"/>
    <Setter Property="Margin" Value="0,0,24,24"/>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/></Trigger>
      <DataTrigger Binding="{Binding IsConnected}" Value="True"><Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}"/></DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- One system card -->
  <DataTemplate x:Key="SystemCard" DataType="vm:ConnectionItem">
    <Border Style="{StaticResource CardBorder}" AutomationProperties.Name="{Binding Name}">
      <Border.InputBindings>
        <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding ConnectCommand, Source={x:Static vm:MainViewModel.Instance}}" CommandParameter="{Binding}"/>
      </Border.InputBindings>
      <DockPanel>
        <Grid DockPanel.Dock="Top">
          <Border Width="40" Height="40" CornerRadius="4" Background="{StaticResource Gray50Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" HorizontalAlignment="Left" VerticalAlignment="Top">
            <c:Icon Data="{Binding CardIcon, Converter={StaticResource Icon}}" Foreground="{StaticResource Gray700Brush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,-8,-8,0" VerticalAlignment="Top">
            <Button Style="{StaticResource FavButton}" AutomationProperties.Name="Favorite"/>
            <Button Style="{StaticResource IconButton}" ToolTip="More actions" AutomationProperties.Name="More actions"
                    Command="{Binding MenuCommand, Source={x:Static vm:MainViewModel.Instance}}" CommandParameter="{Binding}">
              <c:Icon Data="{StaticResource Icon.more}"/>
            </Button>
          </StackPanel>
        </Grid>
        <StackPanel DockPanel.Dock="Top" Margin="0,12,0,0">
          <Button Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Command="{Binding DetailsCommand, Source={x:Static vm:MainViewModel.Instance}}" CommandParameter="{Binding}">
            <TextBlock Text="{Binding Name}" Style="{StaticResource Text.CardTitle}"/>
          </Button>
          <TextBlock Text="{Binding Address}" Style="{StaticResource Text.Mono}" Margin="0,2,0,0"/>
          <TextBlock Text="{Binding MetaLine}" Style="{StaticResource Text.Secondary}" Visibility="{Binding MetaLine, Converter={StaticResource Visible}}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
        </StackPanel>
        <WrapPanel DockPanel.Dock="Top" Margin="0,12,0,0">
          <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource StatusBadge}" Margin="0,0,8,0"/>
          <Border Style="{StaticResource Badge}" Visibility="{Binding IsSample, Converter={StaticResource Visible}}" ToolTip="Mock data for demonstration">
            <TextBlock Text="Sample"/>
          </Border>
          <Border Style="{StaticResource Badge}" Visibility="{Binding IsCentral, Converter={StaticResource Visible}}" ToolTip="Provided by IT. Read-only.">
            <StackPanel Orientation="Horizontal"><c:Icon Data="{StaticResource Icon.shield}" Size="14" Margin="0,0,4,0"/><TextBlock Text="Managed by IT"/></StackPanel>
          </Border>
        </WrapPanel>
        <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Gray100Brush}" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,12,0,0" VerticalAlignment="Bottom">
          <DockPanel LastChildFill="False">
            <TextBlock Text="{Binding LastUsedText}" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxWidth="150"/>
            <Grid DockPanel.Dock="Right">
              <Button Style="{StaticResource Btn.Primary}" Visibility="{Binding IsIdle, Converter={StaticResource Visible}}"
                      Command="{Binding ConnectCommand, Source={x:Static vm:MainViewModel.Instance}}" CommandParameter="{Binding}">
                <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding ConnectLabel}"/><c:Icon Data="{StaticResource Icon.arrowRight}" Margin="8,0,0,0"/></StackPanel>
              </Button>
              <Button Style="{StaticResource Btn.Secondary}" Visibility="{Binding IsConnected, Converter={StaticResource Visible}}"
                      Command="{Binding FocusSessionCommand, Source={x:Static vm:MainViewModel.Instance}}" CommandParameter="{Binding}">
                <StackPanel Orientation="Horizontal">
                  <c:Spinner Width="16" Height="16" Margin="0,0,8,0" Visibility="{Binding IsConnecting, Converter={StaticResource Visible}}"/>
                  <c:Icon Data="{StaticResource Icon.window}" Margin="0,0,8,0" Visibility="{Binding IsConnecting, Converter={StaticResource Visible}, ConverterParameter=invert}"/>
                  <TextBlock><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="Show"/><Style.Triggers><DataTrigger Binding="{Binding IsConnecting}" Value="True"><Setter Property="Text" Value="Connecting…"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                </StackPanel>
              </Button>
            </Grid>
          </DockPanel>
        </Border>
        <Border/>
      </DockPanel>
    </Border>
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:CardRow}">
    <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource SystemCard}" Margin="32,0,8,0" Focusable="False">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate><UniformGrid Rows="1" Columns="{Binding Columns}"/></ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
    </ItemsControl>
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:SkeletonRow}">
    <ItemsControl Margin="32,0,8,0" Focusable="False">
      <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" Columns="{Binding Columns}"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      <Border Height="232" CornerRadius="8" Background="{StaticResource SurfaceMutedBrush}" Margin="0,0,24,24"/>
      <Border Height="232" CornerRadius="8" Background="{StaticResource SurfaceMutedBrush}" Margin="0,0,24,24"/>
      <Border Height="232" CornerRadius="8" Background="{StaticResource SurfaceMutedBrush}" Margin="0,0,24,24"/>
    </ItemsControl>
  </DataTemplate>

  <!-- List view -->
  <DataTemplate DataType="{x:Type vm:ListHeaderRow}">
    <Border Margin="32,0,32,0" Background="{StaticResource Gray50Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8,8,0,0" Padding="16,10">
      <Grid TextElement.FontSize="12" TextElement.FontWeight="SemiBold" TextElement.Foreground="{StaticResource TextSecondaryBrush}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="2*" MinWidth="220"/><ColumnDefinition Width="*" MinWidth="140"/><ColumnDefinition Width="160"/><ColumnDefinition Width="200"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="Name"/><TextBlock Grid.Column="1" Text="Operating system"/><TextBlock Grid.Column="2" Text="Status"/>
      </Grid>
    </Border>
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:ListItemRow}">
    <Border Margin="32,0,32,0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="{Binding Last, Converter={StaticResource LastRowBorder}}" CornerRadius="{Binding Last, Converter={StaticResource LastRowRadius}}">
      <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,12" Background="Transparent" x:Name="Row">
        <Border.InputBindings>
          <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding ConnectCommand, Source={x:Static vm:MainViewModel.Instance}}" CommandParameter="{Binding Item}"/>
        </Border.InputBindings>
        <Grid DataContext="{Binding Item}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" MinWidth="220"/><ColumnDefinition Width="*" MinWidth="140"/><ColumnDefinition Width="160"/><ColumnDefinition Width="200"/>
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <Button Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Command="{Binding DetailsCommand, Source={x:Static vm:MainViewModel.Instance}}" CommandParameter="{Binding}">
              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
            </Button>
            <TextBlock Text="{Binding Address}" Style="{StaticResource Text.Mono}"/>
          </StackPanel>
          <TextBlock Grid.Column="1" Text="{Binding Os}" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}"/>
          <ContentPresenter Grid.Column="2" Content="{Binding}" ContentTemplate="{StaticResource StatusBadge}" VerticalAlignment="Center"/>
          <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource FavButton}" AutomationProperties.Name="Favorite"/>
            <Button Style="{StaticResource IconButton}" ToolTip="More actions" AutomationProperties.Name="More actions" Command="{Binding MenuCommand, Source={x:Static vm:MainViewModel.Instance}}" CommandParameter="{Binding}">
              <c:Icon Data="{StaticResource Icon.more}"/>
            </Button>
            <Button Style="{StaticResource Btn.Primary.Small}" Margin="4,0,0,0" Content="{Binding ConnectLabel}" Visibility="{Binding IsIdle, Converter={StaticResource Visible}}"
                    Command="{Binding ConnectCommand, Source={x:Static vm:MainViewModel.Instance}}" CommandParameter="{Binding}"/>
            <Button Style="{StaticResource Btn.Secondary.Small}" Margin="4,0,0,0" Content="Show" Visibility="{Binding IsConnected, Converter={StaticResource Visible}}"
                    Command="{Binding FocusSessionCommand, Source={x:Static vm:MainViewModel.Instance}}" CommandParameter="{Binding}"/>
          </StackPanel>
        </Grid>
      </Border>
    </Border>
  </DataTemplate>

  <!-- Section header and result count -->
  <DataTemplate DataType="{x:Type vm:SectionHeaderRow}">
    <DockPanel Margin="32,32,32,16" x:Name="Root">
      <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Ghost.Small}" Visibility="{Binding ActionText, Converter={StaticResource Visible}}"
              Command="{Binding ActionCommand}" CommandParameter="{Binding ActionParameter}">
        <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding ActionText}"/><c:Icon Data="{StaticResource Icon.arrowRight}" Size="16" Margin="6,0,0,0"/></StackPanel>
      </Button>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
        <c:Icon Data="{Binding Icon, Converter={StaticResource Icon}}" Margin="0,0,8,0" VerticalAlignment="Center" Visibility="{Binding Icon, Converter={StaticResource Visible}}"/>
        <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Section}"/>
        <TextBlock Text="{Binding Meta}" Style="{StaticResource Text.Secondary}" Margin="12,0,0,3" VerticalAlignment="Bottom"/>
      </StackPanel>
    </DockPanel>
    <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding First}" Value="True"><Setter TargetName="Root" Property="Margin" Value="32,0,32,16"/></DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:ResultCountRow}">
    <TextBlock Text="{Binding Text}" Style="{StaticResource Text.Secondary}" Margin="32,0,32,16"/>
  </DataTemplate>

  <!-- Empty state -->
  <DataTemplate DataType="{x:Type vm:EmptyRow}">
    <Border Margin="32,0,32,24" Padding="24,48" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" CornerRadius="8">
      <StackPanel HorizontalAlignment="Center">
        <c:Icon Data="{Binding Icon, Converter={StaticResource Icon}}" Size="24" Foreground="{StaticResource Gray500Brush}" HorizontalAlignment="Center" Margin="0,0,0,12"/>
        <TextBlock Text="{Binding Title}" Style="{StaticResource Text.CardTitle}" HorizontalAlignment="Center"/>
        <TextBlock Text="{Binding Message}" Style="{StaticResource Text.Secondary}" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="480" Margin="0,4,0,0"/>
        <ItemsControl ItemsSource="{Binding Actions}" HorizontalAlignment="Center" Margin="0,16,0,0" Focusable="False">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel HorizontalAlignment="Center"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="vm:EmptyAction">
              <Button x:Name="B" Margin="4" Style="{StaticResource Btn.Secondary}" Command="{Binding Command}" CommandParameter="{Binding Parameter}">
                <StackPanel Orientation="Horizontal">
                  <c:Icon Data="{Binding Icon, Converter={StaticResource Icon}}" Margin="0,0,8,0" Visibility="{Binding Icon, Converter={StaticResource Visible}}"/>
                  <TextBlock Text="{Binding Label}"/>
                </StackPanel>
              </Button>
              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Style}" Value="primary"><Setter TargetName="B" Property="Style" Value="{StaticResource Btn.Primary}"/></DataTrigger>
                <DataTrigger Binding="{Binding Style}" Value="ghost"><Setter TargetName="B" Property="Style" Value="{StaticResource Btn.Ghost}"/></DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>
  </DataTemplate>

  <!-- Inline alert -->
  <DataTemplate x:Key="AlertTemplate" DataType="{x:Type vm:AlertRow}">
    <Border Margin="32,0,32,12" Padding="16" CornerRadius="8" BorderThickness="1"
            Background="{Binding Kind, Converter={StaticResource AlertBrush}}" BorderBrush="{Binding Kind, Converter={StaticResource AlertBrush}, ConverterParameter=border}">
      <DockPanel>
        <c:Icon DockPanel.Dock="Left" Data="{Binding Icon, Converter={StaticResource Icon}}" Foreground="{Binding Kind, Converter={StaticResource KindBrush}}" VerticalAlignment="Top" Margin="0,0,12,0"/>
        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton.Small}" VerticalAlignment="Top" Margin="0,-6,-6,0" ToolTip="Dismiss" AutomationProperties.Name="Dismiss"
                Visibility="{Binding DismissKey, Converter={StaticResource Visible}}" Command="{Binding DismissCommand}" CommandParameter="{Binding DismissKey}">
          <c:Icon Data="{StaticResource Icon.close}" Size="16"/>
        </Button>
        <StackPanel>
          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding Message}" Foreground="{StaticResource Gray700Brush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
          <ItemsControl ItemsSource="{Binding Actions}" Margin="0,8,0,0" Visibility="{Binding Actions.Count, Converter={StaticResource Visible}}" Focusable="False">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate><Button Style="{StaticResource Btn.Secondary.Small}" Margin="0,0,8,0" Content="{Binding Label}" Command="{Binding Command}" CommandParameter="{Binding Parameter}"/></DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </DockPanel>
    </Border>
  </DataTemplate>
  <DataTemplate DataType="{x:Type vm:AlertRow}">
    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource AlertTemplate}"/>
  </DataTemplate>

  <!-- Active session card -->
  <DataTemplate DataType="{x:Type vm:SessionCardRow}">
    <Border Margin="32,0,32,16" Padding="24" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" DataContext="{Binding Session}">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel>
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" TextElement.Foreground="{Binding StateKey, Converter={StaticResource KindBrush}}" VerticalAlignment="Top">
              <c:Spinner Width="14" Height="14" Margin="0,0,6,0" Visibility="{Binding IsLive, Converter={StaticResource Visible}}"/>
              <TextBlock Text="{Binding StateText}" FontWeight="SemiBold"/>
            </StackPanel>
            <StackPanel>
              <TextBlock Text="{Binding Name}" Style="{StaticResource Text.CardTitle}"/>
              <TextBlock Text="{Binding HostLine}" Style="{StaticResource Text.Mono}"/>
            </StackPanel>
          </DockPanel>
          <WrapPanel Margin="0,12,0,0">
            <StackPanel Margin="0,0,32,0"><TextBlock Text="Started" Style="{StaticResource Text.Label}" Foreground="{StaticResource TextSecondaryBrush}"/><TextBlock Text="{Binding Started}" FontWeight="SemiBold"/></StackPanel>
            <StackPanel Margin="0,0,32,0"><TextBlock Text="Duration" Style="{StaticResource Text.Label}" Foreground="{StaticResource TextSecondaryBrush}"/><TextBlock Text="{Binding Duration}" FontWeight="SemiBold"/></StackPanel>
            <StackPanel Margin="0,0,32,0"><TextBlock Text="Display" Style="{StaticResource Text.Label}" Foreground="{StaticResource TextSecondaryBrush}"/><TextBlock Text="{Binding Info.DisplayMode}" FontWeight="SemiBold"/></StackPanel>
            <StackPanel><TextBlock Text="Launch" Style="{StaticResource Text.Label}" Foreground="{StaticResource TextSecondaryBrush}"/><TextBlock Text="{Binding LaunchText}" FontWeight="SemiBold"/></StackPanel>
          </WrapPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" Margin="24,0,0,0" VerticalAlignment="Top">
          <Button Style="{StaticResource Btn.Secondary}" Command="{Binding FocusCommand}" CommandParameter="{Binding}" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal"><c:Icon Data="{StaticResource Icon.window}" Margin="0,0,8,0"/><TextBlock Text="Show window"/></StackPanel>
          </Button>
          <Button Style="{StaticResource Btn.Danger}" Command="{Binding DisconnectCommand}" CommandParameter="{Binding}">
            <StackPanel Orientation="Horizontal"><c:Icon Data="{StaticResource Icon.disconnect}" Margin="0,0,8,0"/><TextBlock Text="{Binding DisconnectLabel}"/></StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>
  </DataTemplate>

  <!-- History table -->
  <DataTemplate DataType="{x:Type vm:HistoryHeaderRow}">
    <Border Margin="32,0,32,0" Background="{StaticResource Gray50Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8,8,0,0" Padding="16,10">
      <Grid TextElement.FontSize="12" TextElement.FontWeight="SemiBold" TextElement.Foreground="{StaticResource TextSecondaryBrush}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
        <TextBlock Text="System"/><TextBlock Grid.Column="1" Text="When"/><TextBlock Grid.Column="2" Text="Duration"/><TextBlock Grid.Column="3" Text="Result"/>
      </Grid>
    </Border>
  </DataTemplate>

  <DataTemplate x:Key="HistoryRowTemplate" DataType="{x:Type vm:HistoryRow}">
    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="{Binding Last, Converter={StaticResource LastRowBorder}}" CornerRadius="{Binding Last, Converter={StaticResource LastRowRadius}}">
      <Border BorderBrush="{StaticResource Gray100Brush}" BorderThickness="0,1,0,0" Padding="16,12">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{Binding Host}" Style="{StaticResource Text.Mono}"/>
          </StackPanel>
          <TextBlock Grid.Column="1" Text="{Binding When}" VerticalAlignment="Top" TextWrapping="Wrap"/>
          <TextBlock Grid.Column="2" Text="{Binding Duration}" VerticalAlignment="Top"/>
          <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Top" x:Name="Result" TextElement.Foreground="{StaticResource ErrorBrush}">
            <c:Icon x:Name="ResultIcon" Data="{StaticResource Icon.xCircle}" Size="16" Margin="0,0,6,0"/>
            <TextBlock Text="{Binding ResultText}" FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="240"/>
            <TextBlock Text="{Binding CodeText}" FontFamily="{StaticResource MonoFont}" FontSize="12" Margin="6,1,0,0"/>
          </StackPanel>
          <Button Grid.Column="4" HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource Btn.Secondary.Small}" Content="Connect" x:Name="Connect"
                  Command="{Binding ConnectCommand}" CommandParameter="{Binding Connection}"/>
        </Grid>
      </Border>
    </Border>
    <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding Ok}" Value="True">
        <Setter TargetName="Result" Property="TextElement.Foreground" Value="{StaticResource SuccessBrush}"/>
        <Setter TargetName="ResultIcon" Property="Data" Value="{StaticResource Icon.checkCircle}"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding Connection}" Value="{x:Null}">
        <Setter TargetName="Connect" Property="Command" Value="{Binding QuickHostCommand}"/>
        <Setter TargetName="Connect" Property="CommandParameter" Value="{Binding Host}"/>
        <Setter TargetName="Connect" Property="ToolTip" Value="Quick connect (not saved as a system)"/>
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>
  <DataTemplate DataType="{x:Type vm:HistoryRow}">
    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource HistoryRowTemplate}" Margin="32,0,32,0"/>
  </DataTemplate>
</ResourceDictionary>
