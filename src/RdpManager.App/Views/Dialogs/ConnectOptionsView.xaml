<UserControl x:Class="RdpManager.App.Views.Dialogs.ConnectOptionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="clr-namespace:RdpManager.App.Views.Dialogs">
  <StackPanel>
    <TextBlock Text="Username" Style="{StaticResource Text.Label}"/>
    <TextBox x:Name="UserInput" Text="{Binding Username}" IsEnabled="{Binding UsernameEnabled}" AutomationProperties.Name="Username"/>
    <TextBlock Style="{StaticResource Text.Help}" Text="Leave empty to use the account Windows suggests."/>
    <TextBlock Text="Password" Style="{StaticResource Text.Label}" Margin="0,16,0,0"/>
    <TextBlock Style="{StaticResource Text.Secondary}" Text="{Binding CredentialText}"/>
    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,16,0,0" Padding="0,16,0,0">
      <d:DisplayOptions DataContext="{Binding Options}"/>
    </Border>
    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,16,0,0" Padding="0,16,0,0">
      <d:DeviceOptions DataContext="{Binding Options}"/>
    </Border>
    <Expander x:Name="AdvancedExpander" Header="Advanced settings" Margin="0,16,0,0">
      <d:AdvancedOptions DataContext="{Binding Options}" x:Name="Advanced" Margin="0,12,0,0"/>
    </Expander>
    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,16,0,0" Padding="0,8,0,0">
      <StackPanel>
        <CheckBox IsChecked="{Binding PromptAlways}">
          <StackPanel><TextBlock Text="Sign in as a different user"/><TextBlock Style="{StaticResource Text.Help}" Text="Windows asks for a username and password in a separate Remote Desktop window. A saved password is not used for this connection."/></StackPanel>
        </CheckBox>
        <CheckBox IsChecked="{Binding Remember}" Content="Remember these options for this system"/>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
