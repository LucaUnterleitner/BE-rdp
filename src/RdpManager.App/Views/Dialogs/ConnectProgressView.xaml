<UserControl x:Class="RdpManager.App.Views.Dialogs.ConnectProgressView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:RdpManager.App.Controls"
             xmlns:vm="clr-namespace:RdpManager.App.ViewModels">
  <StackPanel>
    <ItemsControl ItemsSource="{Binding Steps}" Focusable="False" AutomationProperties.LiveSetting="Polite">
      <ItemsControl.ItemTemplate>
        <DataTemplate DataType="vm:StepItem">
          <StackPanel Orientation="Horizontal" Margin="0,0,0,12" x:Name="Row" TextElement.Foreground="{StaticResource Gray500Brush}"
                      AutomationProperties.Name="{Binding Label}" AutomationProperties.ItemStatus="{Binding State}">
            <Grid Width="24" Height="24" Margin="0,0,12,0">
              <Ellipse x:Name="Pending" Width="10" Height="10" Stroke="{StaticResource BorderStrongBrush}" StrokeThickness="2"/>
              <c:Spinner x:Name="Spin" Width="18" Height="18" Visibility="Collapsed" Foreground="{StaticResource TextPrimaryBrush}"/>
              <c:Icon x:Name="Done" Data="{Binding State, Converter={StaticResource StepIcon}}" Foreground="{Binding State, Converter={StaticResource KindBrush}}" Visibility="Collapsed"/>
            </Grid>
            <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
          </StackPanel>
          <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding State}" Value="running">
              <Setter TargetName="Pending" Property="Visibility" Value="Collapsed"/>
              <Setter TargetName="Spin" Property="Visibility" Value="Visible"/>
              <Setter TargetName="Row" Property="TextElement.Foreground" Value="{StaticResource TextPrimaryBrush}"/>
              <Setter TargetName="Row" Property="TextElement.FontWeight" Value="SemiBold"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="done">
              <Setter TargetName="Pending" Property="Visibility" Value="Collapsed"/>
              <Setter TargetName="Done" Property="Visibility" Value="Visible"/>
              <Setter TargetName="Row" Property="TextElement.Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="failed">
              <Setter TargetName="Pending" Property="Visibility" Value="Collapsed"/>
              <Setter TargetName="Done" Property="Visibility" Value="Visible"/>
              <Setter TargetName="Row" Property="TextElement.Foreground" Value="{StaticResource ErrorBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="skipped">
              <Setter TargetName="Pending" Property="Visibility" Value="Collapsed"/>
              <Setter TargetName="Done" Property="Visibility" Value="Visible"/>
            </DataTrigger>
          </DataTemplate.Triggers>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <Border Margin="0,8,0,0" Padding="16" CornerRadius="8" BorderThickness="1" Visibility="{Binding HasNote, Converter={StaticResource Visible}}"
            Background="{Binding NoteKind, Converter={StaticResource AlertBrush}}" BorderBrush="{Binding NoteKind, Converter={StaticResource AlertBrush}, ConverterParameter=border}">
      <DockPanel>
        <c:Icon DockPanel.Dock="Left" Data="{Binding NoteIcon, Converter={StaticResource Icon}}" Foreground="{Binding NoteKind, Converter={StaticResource KindBrush}}" Margin="0,0,12,0" VerticalAlignment="Top"/>
        <StackPanel>
          <TextBlock Text="{Binding NoteTitle}" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive"/>
          <TextBlock Text="{Binding NoteMessage}" TextWrapping="Wrap" Foreground="{StaticResource Gray700Brush}" Margin="0,2,0,0"/>
          <Expander Header="Technical details" Margin="0,8,0,0" Visibility="{Binding HasTechnical, Converter={StaticResource Visible}}">
            <TextBox Text="{Binding Technical, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource Input.Mono}" TextWrapping="Wrap" MinHeight="0" Padding="6"/>
          </Expander>
        </StackPanel>
      </DockPanel>
    </Border>
    <Border Margin="0,12,0,0" Padding="16" CornerRadius="8" BorderThickness="1" Background="{StaticResource WarningBgBrush}" BorderBrush="{StaticResource WarningBorderBrush}"
            Visibility="{Binding HasExtra, Converter={StaticResource Visible}}">
      <TextBlock Text="{Binding Extra}" TextWrapping="Wrap"/>
    </Border>
  </StackPanel>
</UserControl>
