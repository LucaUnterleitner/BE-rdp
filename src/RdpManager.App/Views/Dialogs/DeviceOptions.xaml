<UserControl x:Class="RdpManager.App.Views.Dialogs.DeviceOptions"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:RdpManager.App.Controls"
             xmlns:vm="clr-namespace:RdpManager.App.ViewModels">
  <UserControl.Resources>
    <DataTemplate x:Key="Locked">
      <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
        <c:Icon Data="{StaticResource Icon.shield}" Size="14" Margin="0,0,4,0"/>
        <TextBlock Text="Set by IT policy" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Gray700Brush}"/>
      </StackPanel>
    </DataTemplate>
  </UserControl.Resources>
  <StackPanel>
    <CheckBox IsChecked="{Binding Clipboard}" IsEnabled="{Binding ClipboardLocked, Converter={StaticResource Not}}">
      <StackPanel><TextBlock Text="Enable clipboard"/><TextBlock Style="{StaticResource Text.Help}" Text="Copy and paste text and files between this computer and the remote system. Follow the data classification rules."/>
        <ContentPresenter ContentTemplate="{StaticResource Locked}" Visibility="{Binding ClipboardLocked, Converter={StaticResource Visible}}"/></StackPanel>
    </CheckBox>
    <CheckBox IsChecked="{Binding Drives}" IsEnabled="{Binding DrivesLocked, Converter={StaticResource Not}}">
      <StackPanel><TextBlock Text="Redirect local drives"/><TextBlock Style="{StaticResource Text.Help}" Text="The remote system can read and write all drives of this computer. Switch on only to transfer files."/>
        <ContentPresenter ContentTemplate="{StaticResource Locked}" Visibility="{Binding DrivesLocked, Converter={StaticResource Visible}}"/></StackPanel>
    </CheckBox>
    <CheckBox IsChecked="{Binding Printers}" IsEnabled="{Binding PrintersLocked, Converter={StaticResource Not}}">
      <StackPanel><TextBlock Text="Redirect printers"/><TextBlock Style="{StaticResource Text.Help}" Text="Print from the remote system to printers installed on this computer."/>
        <ContentPresenter ContentTemplate="{StaticResource Locked}" Visibility="{Binding PrintersLocked, Converter={StaticResource Visible}}"/></StackPanel>
    </CheckBox>
    <CheckBox IsChecked="{Binding Microphone}" IsEnabled="{Binding MicrophoneLocked, Converter={StaticResource Not}}">
      <StackPanel><TextBlock Text="Use microphone in the remote session"/>
        <ContentPresenter ContentTemplate="{StaticResource Locked}" Visibility="{Binding MicrophoneLocked, Converter={StaticResource Visible}}"/></StackPanel>
    </CheckBox>
    <CheckBox IsChecked="{Binding Smartcards}" IsEnabled="{Binding SmartcardsLocked, Converter={StaticResource Not}}">
      <StackPanel><TextBlock Text="Use smart cards in the remote session"/><TextBlock Style="{StaticResource Text.Help}" Text="Needed for smart card sign-in inside the session."/>
        <ContentPresenter ContentTemplate="{StaticResource Locked}" Visibility="{Binding SmartcardsLocked, Converter={StaticResource Visible}}"/></StackPanel>
    </CheckBox>
    <TextBlock Text="Remote audio" Style="{StaticResource Text.Label}" Margin="0,12,0,4"/>
    <ComboBox Width="280" HorizontalAlignment="Left" ItemsSource="{x:Static vm:OptionsViewModel.AudioOptions}" DisplayMemberPath="Value" SelectedValuePath="Key"
              SelectedValue="{Binding Audio}" IsEnabled="{Binding AudioLocked, Converter={StaticResource Not}}" AutomationProperties.Name="Remote audio"/>
  </StackPanel>
</UserControl>
