<UserControl x:Class="RdpManager.App.Views.Dialogs.ImportPreviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:RdpManager.App.Controls"
             xmlns:vm="clr-namespace:RdpManager.App.ViewModels">
  <StackPanel>
    <ItemsControl x:Name="Items" Focusable="False">
      <ItemsControl.ItemTemplate>
        <DataTemplate DataType="vm:ImportPreviewRow">
          <Border x:Name="B" Margin="0,0,0,12" Padding="16,12" CornerRadius="8" BorderThickness="1" Background="{StaticResource Gray50Brush}" BorderBrush="{StaticResource BorderBrush}">
            <DockPanel>
              <c:Icon DockPanel.Dock="Left" x:Name="I" Data="{Binding Icon, Converter={StaticResource Icon}}" Margin="0,0,12,0" VerticalAlignment="Top"/>
              <StackPanel>
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Mono}" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding Permissions}" FontSize="13" Margin="0,4,0,0" Visibility="{Binding Permissions, Converter={StaticResource Visible}}"/>
                <ItemsControl ItemsSource="{Binding Warnings}" Margin="0,6,0,0" Visibility="{Binding HasWarnings, Converter={StaticResource Visible}}" Focusable="False">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate><TextBlock Text="{Binding StringFormat=• {0}}" FontSize="13" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap"/></DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </DockPanel>
          </Border>
          <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Kind}" Value="error">
              <Setter TargetName="B" Property="Background" Value="{StaticResource ErrorBgBrush}"/>
              <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource ErrorBorderBrush}"/>
              <Setter TargetName="I" Property="Foreground" Value="{StaticResource ErrorBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="notice">
              <Setter TargetName="B" Property="Background" Value="{StaticResource InfoBgBrush}"/>
              <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource InfoBorderBrush}"/>
              <Setter TargetName="I" Property="Foreground" Value="{StaticResource InfoBrush}"/>
            </DataTrigger>
          </DataTemplate.Triggers>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <TextBlock x:Name="More" Style="{StaticResource Text.Secondary}" FontSize="14"/>
  </StackPanel>
</UserControl>
