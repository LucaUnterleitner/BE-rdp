<UserControl x:Class="RdpManager.App.Views.Dialogs.QuickConnectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:RdpManager.App.Controls"
             xmlns:vm="clr-namespace:RdpManager.App.ViewModels">
  <StackPanel>
    <Grid>
      <TextBox x:Name="InputBox" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" Padding="38,0,10,0" AutomationProperties.Name="Address or saved system" PreviewKeyDown="OnKey"/>
      <c:Icon Data="{StaticResource Icon.connect}" Foreground="{StaticResource Gray500Brush}" HorizontalAlignment="Left" Margin="12,0,0,0" VerticalAlignment="Center"/>
      <TextBlock Text="{Binding Placeholder}" Foreground="{StaticResource Gray500Brush}" Margin="40,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                 Visibility="{Binding Text, ElementName=InputBox, Converter={StaticResource Visible}, ConverterParameter=invert}"/>
    </Grid>
    <Border Margin="0,12,0,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
      <Grid>
        <TextBlock Text="{Binding EmptyText}" Style="{StaticResource Text.Secondary}" FontSize="14" Margin="16" Visibility="{Binding IsEmpty, Converter={StaticResource Visible}}"/>
        <ListBox x:Name="Options" ItemsSource="{Binding Options}" SelectedIndex="{Binding Index}" BorderThickness="0" Focusable="False" MaxHeight="360"
                 Visibility="{Binding IsEmpty, Converter={StaticResource Visible}, ConverterParameter=invert}" MouseLeftButtonUp="OnClick"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="Focusable" Value="False"/>
              <Setter Property="Cursor" Value="Hand"/>
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                      <Border x:Name="Bd" Background="Transparent" BorderBrush="{StaticResource Gray100Brush}" BorderThickness="0,0,0,1" Padding="16,10"><ContentPresenter/></Border>
                      <Rectangle x:Name="Mark" Width="3" HorizontalAlignment="Left" Fill="{StaticResource PrimaryBrush}" Visibility="Collapsed"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsSelected" Value="True">
                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceMutedBrush}"/>
                        <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                      </Trigger>
                      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource Gray50Brush}"/></Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate DataType="vm:QuickOption">
              <DockPanel>
                <ContentPresenter DockPanel.Dock="Right" Content="{Binding System}" ContentTemplate="{StaticResource StatusBadge}" Visibility="{Binding System, Converter={StaticResource Visible}}" VerticalAlignment="Center"/>
                <c:Icon DockPanel.Dock="Left" Data="{Binding Icon, Converter={StaticResource Icon}}" Size="16" Margin="0,2,10,0" VerticalAlignment="Top"/>
                <StackPanel>
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Text="{Binding Hint}" Style="{StaticResource Text.Secondary}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
              </DockPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Border>
    <CheckBox IsChecked="{Binding Save}" Margin="0,8,0,0">
      <StackPanel><TextBlock Text="Save to My systems"/><TextBlock Style="{StaticResource Text.Help}" Text="Otherwise the address is used once and not stored. It still appears in Recent sessions."/></StackPanel>
    </CheckBox>
    <TextBlock Style="{StaticResource Text.Secondary}" Margin="0,8,0,0" Text="Arrow keys to choose, Enter to connect, Esc to close."/>
  </StackPanel>
</UserControl>
