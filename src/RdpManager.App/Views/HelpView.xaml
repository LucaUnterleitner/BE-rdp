<UserControl x:Class="RdpManager.App.Views.HelpView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <Style x:Key="P" TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,8,0,0"/></Style>
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
    <StackPanel Margin="32" MaxWidth="1440">
      <TextBlock Text="Help and troubleshooting" Style="{StaticResource Text.PageTitle}"/>
      <TextBlock Text="Answers to common questions and what connection errors mean." Style="{StaticResource Text.Secondary}" FontSize="14" Margin="0,4,0,24"/>
      <UniformGrid Columns="2">
        <Border Style="{StaticResource SettingsCard}" Margin="0,0,16,16">
          <StackPanel>
            <TextBlock Text="How connections work" Style="{StaticResource Text.CardTitle}"/>
            <TextBlock Style="{StaticResource P}" Text="This app manages your systems and opens Remote Desktop sessions as tabs, using the Remote Desktop component built into Windows. Separate Remote Desktop windows (mstsc.exe) are available in Settings. Both use Microsoft's encryption, Network Level Authentication and RD Gateway support."/>
            <TextBlock Style="{StaticResource P}" Text="Before connecting, the app checks whether the system answers on its Remote Desktop port. This check does not sign in."/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,16">
          <StackPanel>
            <TextBlock Text="Disconnect or sign out?" Style="{StaticResource Text.CardTitle}"/>
            <TextBlock Style="{StaticResource P}"><Run FontWeight="SemiBold" Text="Disconnect"/><Run Text=" closes the session here. Your programs keep running on the server, and you can reconnect."/></TextBlock>
            <TextBlock Style="{StaticResource P}"><Run FontWeight="SemiBold" Text="Sign out"/><Run Text=" (inside the remote session, Start menu) ends the session and closes your programs."/></TextBlock>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource SettingsCard}" Margin="0,0,16,16">
          <StackPanel>
            <TextBlock Text="Windows asks me to confirm every connection" Style="{StaticResource Text.CardTitle}"/>
            <TextBlock Style="{StaticResource P}" Text="This applies to separate Remote Desktop windows. Since April 2026, Windows shows a security confirmation each time a Remote Desktop file is opened. Check that the computer name is the one you expect and that only the devices you need are listed, then select Connect."/>
            <TextBlock Style="{StaticResource P}" Text="IT can remove the prompt by signing connection files with a trusted certificate (Settings, signing certificate). Alternatively, &quot;Start directly without a file&quot; skips it with fewer options."/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,16">
          <StackPanel>
            <TextBlock Text="Passwords" Style="{StaticResource Text.CardTitle}"/>
            <TextBlock Style="{StaticResource P}" Text="The app never stores passwords itself. If you choose to save one, it goes to Windows Credential Manager, protected by your Windows account. Don't save passwords on shared computers."/>
          </StackPanel>
        </Border>
      </UniformGrid>

      <TextBlock Text="Keyboard shortcuts" Style="{StaticResource Text.Section}" Margin="0,16,0,16"/>
      <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
        <ItemsControl ItemsSource="{Binding Shortcuts}" Focusable="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border BorderBrush="{StaticResource Gray100Brush}" BorderThickness="0,0,0,1" Padding="16,10">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Key}" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap"/></Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>

      <DockPanel Margin="0,32,0,16">
        <TextBlock Text="Technical codes shown by Remote Desktop and what to do" Style="{StaticResource Text.Secondary}" DockPanel.Dock="Right" VerticalAlignment="Bottom"/>
        <TextBlock Text="Error codes" Style="{StaticResource Text.Section}"/>
      </DockPanel>
      <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
        <ItemsControl ItemsSource="{Binding Codes}" Focusable="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border BorderBrush="{StaticResource Gray100Brush}" BorderThickness="0,0,0,1" Padding="16,10">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Code}" FontFamily="{StaticResource MonoFont}"/>
                  <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,16,0"/>
                  <TextBlock Grid.Column="2" Text="{Binding Message}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
