<UserControl x:Class="RdpManager.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:RdpManager.App.Controls">
  <UserControl.Resources>
    <Style x:Key="Title" TargetType="TextBlock" BasedOn="{StaticResource Text.CardTitle}"><Setter Property="Margin" Value="0,0,0,4"/></Style>
    <Style x:Key="Desc" TargetType="TextBlock" BasedOn="{StaticResource Text.Secondary}"><Setter Property="FontSize" Value="14"/><Setter Property="Margin" Value="0,0,0,12"/></Style>
    <Style x:Key="Help" TargetType="TextBlock" BasedOn="{StaticResource Text.Secondary}"/>
    <Style x:Key="KvKey" TargetType="TextBlock" BasedOn="{StaticResource Text.Secondary}"><Setter Property="Width" Value="160"/></Style>
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
    <StackPanel Margin="32" MaxWidth="860" HorizontalAlignment="Left">
      <TextBlock Text="Settings" Style="{StaticResource Text.PageTitle}"/>
      <TextBlock Text="Preferences for this computer. Settings of individual systems are edited on the system." Style="{StaticResource Desc}" Margin="0,4,0,24"/>

      <Border Style="{StaticResource SettingsCard}">
        <StackPanel>
          <TextBlock Text="Where sessions open" Style="{StaticResource Title}"/>
          <RadioButton GroupName="window" IsChecked="{Binding Tabs}">
            <StackPanel><TextBlock Text="As tabs in this app (recommended)"/><TextBlock Style="{StaticResource Help}" Text="Drag a tab out to open it in its own window, drag it to the top edge of the screen for full screen, and drag it back onto the tab bar to dock it. Ctrl+Alt+Break switches full screen on and off."/></StackPanel>
          </RadioButton>
          <RadioButton GroupName="window" IsChecked="{Binding External}">
            <StackPanel><TextBlock Text="In separate Remote Desktop windows"/><TextBlock Style="{StaticResource Help}" Text="Uses the Windows Remote Desktop client (mstsc). Systems set to use multiple monitors always open this way."/></StackPanel>
          </RadioButton>
          <CheckBox IsChecked="{Binding KeysToRemote}">
            <StackPanel><TextBlock Text="Send Windows key combinations to the remote computer"/><TextBlock Style="{StaticResource Help}" Text="In tabs, keys such as Alt+Tab and the Windows key go to the remote computer instead of this one. In full screen they always do. Press Ctrl+Alt+Left arrow to return the keyboard to the app."/></StackPanel>
          </CheckBox>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource SettingsCard}">
        <StackPanel>
          <TextBlock Text="Separate Remote Desktop windows" Style="{StaticResource Title}"/>
          <TextBlock Style="{StaticResource Desc}" Text="Since April 2026, Windows asks for confirmation each time a Remote Desktop file is opened, unless the file is signed by a publisher your IT trusts."/>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,8" Visibility="{Binding LaunchNote, Converter={StaticResource Visible}}">
            <c:Icon Data="{StaticResource Icon.shield}" Size="16" Margin="0,0,6,0"/><TextBlock Text="{Binding LaunchNote}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Gray700Brush}"/>
          </StackPanel>
          <StackPanel IsEnabled="{Binding LaunchLocked, Converter={StaticResource Not}}">
            <RadioButton GroupName="launch" IsChecked="{Binding LaunchFile}">
              <StackPanel><TextBlock Text="Use a connection file (recommended)"/><TextBlock Style="{StaticResource Help}" Text="All options apply: username, devices, clipboard, gateway. Windows shows its security confirmation unless the file is signed."/></StackPanel>
            </RadioButton>
            <RadioButton GroupName="launch" IsChecked="{Binding LaunchDirect}">
              <StackPanel><TextBlock Text="Start directly without a file"/><TextBlock Style="{StaticResource Help}" Text="No confirmation dialog. Only display, multi-monitor, gateway, admin and credential protection apply; device redirection and username come from Windows' Default.rdp."/></StackPanel>
            </RadioButton>
          </StackPanel>
          <TextBlock Text="Signing certificate thumbprint (SHA-256, optional)" Style="{StaticResource Text.Label}" Margin="0,16,0,4"/>
          <TextBox Style="{StaticResource Input.Mono}" Text="{Binding Thumbprint}" IsEnabled="{Binding ThumbprintLocked, Converter={StaticResource Not}}" AutomationProperties.Name="Signing certificate thumbprint"/>
          <TextBlock Style="{StaticResource Text.Help}" Text="When set, connection files are signed with rdpsign.exe. The certificate must be installed on this computer and trusted by Group Policy."/>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource SettingsCard}">
        <StackPanel>
          <TextBlock Text="Defaults for new systems" Style="{StaticResource Title}"/>
          <TextBlock Style="{StaticResource Desc}" Text="Least-privilege defaults. Each system can override them."/>
          <StackPanel Visibility="{Binding ShowDisplayMode, Converter={StaticResource Visible}}" Width="240" HorizontalAlignment="Left" Margin="0,0,0,8">
            <TextBlock Text="Display in separate windows" Style="{StaticResource Text.Label}"/>
            <ComboBox SelectedIndex="{Binding DisplayModeIndex}"><ComboBoxItem Content="Full screen"/><ComboBoxItem Content="Window"/></ComboBox>
          </StackPanel>
          <CheckBox IsChecked="{Binding DefMultimon}"><StackPanel><TextBlock Text="Use all monitors"/><TextBlock Style="{StaticResource Help}" Text="These systems open in a separate Remote Desktop window."/></StackPanel></CheckBox>
          <CheckBox IsChecked="{Binding DefClipboard}" Content="Enable clipboard"/>
          <CheckBox IsChecked="{Binding DefPrinters}" Content="Redirect printers"/>
          <CheckBox IsChecked="{Binding DefDrives}"><StackPanel><TextBlock Text="Redirect local drives"/><TextBlock Style="{StaticResource Help}" Text="Not recommended as a default."/></StackPanel></CheckBox>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource SettingsCard}">
        <StackPanel>
          <TextBlock Text="Availability checks" Style="{StaticResource Title}"/>
          <TextBlock Style="{StaticResource Desc}" Text="The app opens a short network connection to each system's Remote Desktop port (or the gateway) to show its status. No sign-in happens."/>
          <TextBlock Text="Check every" Style="{StaticResource Text.Label}"/>
          <ComboBox Width="240" HorizontalAlignment="Left" ItemsSource="{Binding RefreshOptions}" DisplayMemberPath="Value" SelectedValuePath="Key" SelectedValue="{Binding StatusRefreshSeconds}" AutomationProperties.Name="Check every"/>
          <CheckBox IsChecked="{Binding ConfirmDisconnect}" Content="Ask before disconnecting a session" Margin="0,8,0,0"/>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource SettingsCard}">
        <StackPanel>
          <TextBlock Text="App behavior" Style="{StaticResource Title}"/>
          <TextBlock Style="{StaticResource Desc}" Text="Recent systems also appear in the taskbar jump list (right-click the app icon)."/>
          <CheckBox IsChecked="{Binding KeepRunningInTray}"><StackPanel><TextBlock Text="Keep running in the notification area while sessions are open"/><TextBlock Style="{StaticResource Help}" Text="Closing the window then hides the app, so session results are still recorded."/></StackPanel></CheckBox>
          <CheckBox IsChecked="{Binding StartWithWindows}"><StackPanel><TextBlock Text="Start with Windows"/><TextBlock Style="{StaticResource Help}" Text="Starts in the notification area when you sign in."/></StackPanel></CheckBox>
        </StackPanel>
      </Border>

      <Button Style="{StaticResource Btn.Primary}" HorizontalAlignment="Left" Content="Save settings" Command="{Binding SaveCommand}" Margin="0,0,0,24"/>

      <Border Style="{StaticResource SettingsCard}">
        <StackPanel>
          <TextBlock Text="IT policy" Style="{StaticResource Title}"/>
          <Border Padding="12" Margin="0,0,0,12" CornerRadius="8" BorderThickness="1" Background="{StaticResource WarningBgBrush}" BorderBrush="{StaticResource WarningBorderBrush}" Visibility="{Binding Policy.Rejected, Converter={StaticResource Visible}}">
            <StackPanel><TextBlock Text="Policy file ignored" FontWeight="SemiBold"/><TextBlock Text="{Binding Policy.Rejected}" TextWrapping="Wrap"/></StackPanel>
          </Border>
          <TextBlock Style="{StaticResource Desc}" Text="{Binding PolicyDescription}"/>
          <StackPanel Orientation="Horizontal"><TextBlock Text="Policy file" Style="{StaticResource KvKey}"/><TextBlock Text="{Binding Policy.File}" FontFamily="{StaticResource MonoFont}" FontSize="13" TextWrapping="Wrap"/></StackPanel>
          <StackPanel Orientation="Horizontal"><TextBlock Text="Saving passwords" Style="{StaticResource KvKey}"/><TextBlock Text="{Binding SavingPasswords}" FontSize="13"/></StackPanel>
          <StackPanel Orientation="Horizontal" Visibility="{Binding LockedOptions, Converter={StaticResource Visible}}"><TextBlock Text="Locked options" Style="{StaticResource KvKey}"/><TextBlock Text="{Binding LockedOptions}" FontSize="13" TextWrapping="Wrap"/></StackPanel>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource SettingsCard}" Visibility="{Binding CentralConfigured, Converter={StaticResource Visible}}">
        <StackPanel>
          <TextBlock Text="IT system list" Style="{StaticResource Title}"/>
          <TextBlock Style="{StaticResource Desc}" Text="Systems provided by IT. They are read-only here; the signature is checked before use."/>
          <StackPanel Orientation="Horizontal"><TextBlock Text="Source" Style="{StaticResource KvKey}"/><TextBlock Text="{Binding CentralSource}" FontFamily="{StaticResource MonoFont}" FontSize="13" TextWrapping="Wrap"/></StackPanel>
          <StackPanel Orientation="Horizontal"><TextBlock Text="Status" Style="{StaticResource KvKey}"/><TextBlock Text="{Binding CentralStatus}" FontSize="13"/></StackPanel>
          <StackPanel Orientation="Horizontal" Visibility="{Binding CentralVersion, Converter={StaticResource Visible}}"><TextBlock Text="Version" Style="{StaticResource KvKey}"/><TextBlock Text="{Binding CentralVersion}" FontSize="13"/></StackPanel>
          <StackPanel Orientation="Horizontal" Visibility="{Binding CentralLoaded, Converter={StaticResource Visible}}"><TextBlock Text="Loaded" Style="{StaticResource KvKey}"/><TextBlock Text="{Binding CentralLoaded}" FontSize="13"/></StackPanel>
          <StackPanel Orientation="Horizontal" Visibility="{Binding CentralError, Converter={StaticResource Visible}}"><TextBlock Text="Last error" Style="{StaticResource KvKey}"/><TextBlock Text="{Binding CentralError}" FontSize="13" TextWrapping="Wrap" MaxWidth="520"/></StackPanel>
          <Button Style="{StaticResource Btn.Secondary}" HorizontalAlignment="Left" Margin="0,16,0,0" Command="{Binding Main.RefreshCentralCommand}">
            <StackPanel Orientation="Horizontal"><c:Icon Data="{StaticResource Icon.refresh}" Margin="0,0,8,0"/><TextBlock Text="Refresh now"/></StackPanel>
          </Button>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource SettingsCard}" Visibility="{Binding AuthConfigured, Converter={StaticResource Visible}}">
        <StackPanel>
          <TextBlock Text="Microsoft Entra ID" Style="{StaticResource Title}"/>
          <TextBlock Style="{StaticResource Desc}" Text="Sign-in with your work account, configured by IT."/>
          <StackPanel Orientation="Horizontal"><TextBlock Text="Status" Style="{StaticResource KvKey}"/><TextBlock Text="{Binding AuthStatus}" FontSize="13" TextWrapping="Wrap"/></StackPanel>
          <Button Style="{StaticResource Btn.Secondary}" HorizontalAlignment="Left" Margin="0,16,0,0" Content="Sign in with Microsoft" Command="{Binding Main.SignInCommand}"/>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource SettingsCard}">
        <StackPanel>
          <TextBlock Text="Data and audit log" Style="{StaticResource Title}"/>
          <TextBlock Style="{StaticResource Desc}" Text="System list, settings and the local audit log (connections, results, changes; never passwords) are stored for your Windows account only."/>
          <StackPanel Orientation="Horizontal"><TextBlock Text="Folder" Style="{StaticResource KvKey}"/><TextBlock Text="{Binding DataFolder}" FontFamily="{StaticResource MonoFont}" FontSize="13" TextWrapping="Wrap"/></StackPanel>
          <StackPanel Orientation="Horizontal"><TextBlock Text="App version" Style="{StaticResource KvKey}"/><TextBlock Text="{Binding Version}" FontSize="13"/></StackPanel>
          <StackPanel Orientation="Horizontal"><TextBlock Text="Installation" Style="{StaticResource KvKey}"/><TextBlock Text="{Binding Packaging}" FontSize="13" TextWrapping="Wrap" MaxWidth="560"/></StackPanel>
          <StackPanel Orientation="Horizontal"><TextBlock Text="Previous app version" Style="{StaticResource KvKey}"/><TextBlock Text="{Binding MigrationStatus}" FontSize="13" TextWrapping="Wrap" MaxWidth="560"/></StackPanel>
          <WrapPanel Margin="0,16,0,0">
            <Button Style="{StaticResource Btn.Secondary}" Margin="0,0,8,8" Command="{Binding Main.OpenDataFolderCommand}">
              <StackPanel Orientation="Horizontal"><c:Icon Data="{StaticResource Icon.folder}" Margin="0,0,8,0"/><TextBlock Text="Open folder"/></StackPanel>
            </Button>
            <Button Style="{StaticResource Btn.Secondary}" Margin="0,0,8,8" Content="Open app log" Command="{Binding OpenLogsCommand}"/>
            <Button Style="{StaticResource Btn.Secondary}" Margin="0,0,8,8" Content="Import from previous app version again" Command="{Binding RerunMigrationCommand}" Visibility="{Binding LegacyDataExists, Converter={StaticResource Visible}}"/>
            <Button Style="{StaticResource Btn.Ghost}" Margin="0,0,8,8" Content="Load sample systems (mock data)" Command="{Binding Main.LoadSamplesCommand}"/>
          </WrapPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
